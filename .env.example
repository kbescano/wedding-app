# Long random string used to sign sessions. Generate one: openssl rand -hex 32
PAYLOAD_SECRET=
# Optional. Defaults: data/wedding-dev.db (npm run dev) and data/wedding.db (npm start).
# In production point this at a persistent path, e.g. file:/var/data/wedding.db
# DATABASE_URI=file:./data/wedding.db

# --- Serverless hosting (Netlify, Vercel, …) only ---
# These hosts give the app a fresh, read-only filesystem per request, so the local file above and
# local photo storage don't work there. Set these instead; leave them all unset for local dev or a
# host with a persistent disk (Fly, Railway, a VPS), where the defaults above are fine as-is.

# A Turso database (https://turso.tech, free tier). Create one, then:
#   turso db create wedding-app && turso db show wedding-app --url && turso db tokens create wedding-app
# DATABASE_URI=libsql://<your-db>.turso.io
# TURSO_AUTH_TOKEN=

# A Cloudflare R2 bucket (https://dash.cloudflare.com, free tier) for uploaded photos: create a bucket
# and an API token (R2 → Manage API Tokens), then:
# R2_BUCKET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
