{
  "name": "wedding-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A guest-only wedding invitation, memories, messages and quiz app.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "demo": "node server/seed-demo.js",
    "admin:password": "node server/set-admin-password.js",
    "reset": "node -e \"require('fs').rmSync(process.env.DATA_DIR||'data',{recursive:true,force:true});console.log('Data wiped.')\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "express": "^5.2.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.0"
  }
}
